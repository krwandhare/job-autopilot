# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local database
/data/*.db
/data/*.db-journal
/data/*.db-shm
/data/*.db-wal
/data/resumes/
/data/cv-archive/
!/data/.gitkeep

# background queue runner
/data/queue-runner.log
/data/queue-runner.pid
/data/gmail-sync-runner.log
/data/gmail-sync-runner.pid

# typescript
*.tsbuildinfo
next-env.d.ts

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
