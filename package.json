{
  "name": "job-autopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate": "npm run lint && npx tsc --noEmit && npm run build",
    "test": "bash scripts/test-all.sh",
    "dev:shared": "scripts/dev-shared-runtime.sh",
    "test:integration-automation": "bash scripts/test-integration-automation.sh",
    "test:action-center": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-action-center.mjs",
    "test:resume-evidence": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-resume-evidence.mjs",
    "test:resume-layout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-resume-layout.mjs",
    "test:resume-requirements": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-resume-requirements.mjs",
    "test:resume-variants": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-resume-variants.mjs",
    "test:resume-artifacts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-resume-artifacts.mjs",
    "test:resume-server-config": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-resume-server-config.mjs",
    "test:resume-upload-validation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-resume-upload-validation.mjs",
    "test:resume-analysis-routes": "bash scripts/test-resume-analysis-routes.sh",
    "test:tailored-resume-generator": "playwright test tests/tailored-resume-generator.spec.ts --workers=1 --reporter=line --output=${PLAYWRIGHT_OUTPUT_DIR:-test-results}",
    "test:submission-guard": "playwright test tests/submission-guard.spec.ts --workers=1 --reporter=line --output=${PLAYWRIGHT_OUTPUT_DIR:-test-results}",
    "test:gmail-leads": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-gmail-leads.mjs",
    "test:applications": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-applications.mjs",
    "test:cv-archive": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-cv-archive.mjs",
    "test:autofill-upload": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-autofill-upload.mjs",
    "test:autofill-errors": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-autofill-errors.mjs",
    "test:api-validation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-api-validation.mjs",
    "test:core-fixtures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-core-fixtures.mjs",
    "test:core-routes": "bash scripts/test-core-route-integration.sh",
    "test:queue-runner": "bash scripts/test-queue-runner.sh",
    "test:shared-runtime": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-shared-runtime.mjs",
    "test:shared-runtime-routes": "bash scripts/test-shared-runtime-routes.sh"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "cheerio": "^1.2.0",
    "geist": "^1.7.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "playwright": "^1.62.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
